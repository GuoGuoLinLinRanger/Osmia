# Copy to .env (in OSMIA_HOME) and fill in. .env is gitignored — never commit it.

# Where the DuckDB file, balances.json, backups and .env live. Defaults to the repo folder.
# OSMIA_HOME=/opt/llm_trader
# OSMIA_DB_PATH=
# OSMIA_BALANCES_FILE=

# ── LLM ──────────────────────────────────────────────────────────────────────
# openai (default): any OpenAI-compatible chat-completions endpoint
#   local:  llama.cpp / vLLM / LM Studio / Ollama (http://localhost:11434/v1/chat/completions)
#   hosted: OpenRouter, Groq, OpenAI... (set OSMIA_LLM_API_KEY)
# anthropic: Claude via the official SDK — pip install 'osmia[anthropic]' and set ANTHROPIC_API_KEY
OSMIA_LLM_PROVIDER=openai
OSMIA_LLM_URL=http://localhost:8081/v1/chat/completions
OSMIA_LLM_MODEL=qwen-instruct
OSMIA_LLM_API_KEY=
# ANTHROPIC_API_KEY=

# ── Market data ──────────────────────────────────────────────────────────────
# Any ccxt exchange id. Binance blocks US and most cloud IPs (HTTP 451):
# use binanceus, kraken, coinbase... there.
OSMIA_EXCHANGE=binance

# ── Optional ─────────────────────────────────────────────────────────────────
OSMIA_DISCORD_WEBHOOK=
CMC_API_KEY=
UNMINEABLE_ADDRESS=
