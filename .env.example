# Copy to .env (in OSMIA_HOME) and fill in. .env is gitignored — never commit it.

# Where the DuckDB file, balances.json and .env live. Defaults to the repo folder.
# OSMIA_HOME=/opt/llm_trader
# OSMIA_DB_PATH=
# OSMIA_BALANCES_FILE=

# Any OpenAI-compatible chat-completions endpoint (llama.cpp, vLLM, LM Studio, Ollama...).
OSMIA_LLM_URL=http://localhost:8081/v1/chat/completions
OSMIA_LLM_MODEL=qwen-instruct

# Optional
OSMIA_DISCORD_WEBHOOK=
CMC_API_KEY=
UNMINEABLE_ADDRESS=
