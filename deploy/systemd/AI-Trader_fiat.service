[Unit]
Description=Osmia trader fiat entry analyzer
After=network.target

[Service]
Type=oneshot
User=osmia
WorkingDirectory=/opt/llm_trader
Environment="OSMIA_HOME=/opt/llm_trader"
Environment="PATH=/opt/llm_trader/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/llm_trader/venv/bin/python3 -m osmia --fiat

[Install]
WantedBy=multi-user.target
