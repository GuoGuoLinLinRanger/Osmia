[Unit]
Description=Osmia trader DB backup (checkpoint + copy)
After=network.target

[Service]
Type=oneshot
User=osmia
WorkingDirectory=/opt/llm_trader
Environment="PATH=/opt/llm_trader/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/llm_trader/venv/bin/python3 /opt/llm_trader/backup_db.py

[Install]
WantedBy=multi-user.target
